  <string name="tooltip_imageToMSFSKTX2Path">ImageToMSFSKTX2-kansio</string>
  <string name="tooltip_layoutGeneratorToolPath">Layoutgenerator-työkalun suoritustiedosto.\nKoska tämä tiedosto tallennetaan mihin tahansa kohtaan tiedostojärjestelmässäsi</string>
  <string name="tooltip_liveryName">Sen maalausprojektin nimi, jonka parissa työskentelet.\nSen tulisi olla yksilöllinen kaikille lentokoneen maalauksille.</string>
  <string name="tooltip_locale">Kieli</string>
  <string name="tooltip_mainLibraryRootFolder">Pääkirjastosi juurikansio, jossa on lisäosat\ntai paikka, johon tallennat lopulliset pakettisi toimitusta varten.\nTätä käytetään Filechoose-työkalun aloituskansiona.</string>
  <string name="tooltip_modelTexturesDir">Blender-projektisi (tai sen projektin, jonka parissa työskentelet) tekstuurikansio.\nTämä on kansio, johon mallisi tekstuurit on tallennettu PNG-tiedostoina.</string>
  <string name="tooltip_nvidiaTextureToolPath">Suoritustiedosto „NVIDIA Texturetool“.\nTämä on pakollinen ja tarvitaan tekstuurien muuntamiseen PNG-muotoon mistä tahansa simulointimuodosta.\nOletuspolku on C:/Program Files/NVIDIA Corporation/NVIDIA Texture Tools/nvtt_export.exe.</string>
  <string name="tooltip_openInExplorer">Avaa Explorerissa.</string>
  <string name="tooltip_packageDir">Lisäosarakenteen juurikansio pääkirjastossasi.</string>
  <string name="tooltip_packageTextureDir">Pakettisi tekstuurikansion hakemisto.</string>
  <string name="tooltip_projectRootFolder">Blender-projektiesi juurikansio\ntai missä tahansa tallennat maalauksesi.\nTätä käytetään tiedostojen valinnan aloituskansiona.</string>
  <string name="tooltip_readonly">Kenttää ei voi muokata.</string>
  <string name="tooltip_sdkRoot">MSFS SDK:n juurikansio.\nJos olet aiemmin käyttänyt ImageToMSFSKTX2-työkalua, se tuodaan myös, kun napsautat ”Tuo”-painiketta.\nSDK on pakollinen, jos työskentelet projekteissa, jotka käyttävät KTX2-muotoa, koska NVIDIA-työkalulla muunnettuja kuvia ei voi käyttää simulaattorissa.\nOletusarvo on C:/MSFS 2024 SDK</string>
  <string name="tooltip_simType">Käyttämäsi kauppa.\nJoko Microsoft tai Steam.\nOletusarvo on Microsoft.</string>
  <string name="tooltip_textureFormat">Tekstuuriformaatti, jota projektisi käyttää MSFS2024:ssä.\nDDS tai KTX2.\nTämä arvo lasketaan automaattisesti paketin tekstuurihakemistosta.</string>
  <string name="tooltip_textureTypes">Tekstuurityypit, jotka haluat sisällyttää muunnoksiin.\nMSFS-paketit voivat sisältää monia tekstuureja, ja yleensä käytämme vain\n albedo- (ALBD) ja kompositio- (COMP) tiedostoja.\nUseimmissa tapauksissa sinun tulisi siis valita ALBD ja COMP.\nJos projektissasi ei käytetä metallivärejä, voit huoletta valita vain ALBD:n.</string>
  <string name="true">Totta</string>
