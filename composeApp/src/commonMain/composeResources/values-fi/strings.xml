  <string name="tooltip_airplaneName">Sen lentokoneen nimi, jolle haluat luoda maalauksen.\nSen tulisi olla yksilöllinen kaikissa projekteissasi.\nJos työskentelet useiden maalauksien parissa samalle lentokoneelle, varmista, että nimi on yhdenmukainen kaikissa projekteissasi.</string>
  <string name="tooltip_airplanes">Kaikkien lentokoneiden nimet, joiden parissa työskentelet.</string>
  <string name="tooltip_browseDirectories">Selaa kansioita.</string>
