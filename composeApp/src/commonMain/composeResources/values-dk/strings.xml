  <string name="tooltip_mainLibraryRootFolder">Rodmappen i dit hovedbibliotek med add-ons\neller det sted, hvor du gemmer dine endelige pakker til levering.\nDette bruges som startmappe for Filechoose.</string>
  <string name="tooltip_modelTexturesDir">Teksturkataloget for dit Blender-projekt (eller det projekt, du arbejder på).\nDette er det katalog, hvor dine modelteksturer er gemt som PNG-filer.</string>
  <string name="tooltip_nvidiaTextureToolPath">Den eksekverbare fil „NVIDIA Texturetool“.\nDette er obligatorisk og nødvendigt for at konvertere teksturer fra ethvert simuleringsformat til PNG.\nStandardstien er C:/Program Files/NVIDIA Corporation/NVIDIA Texture Tools/nvtt_export.exe.</string>
  <string name="tooltip_openInExplorer">Åbn i Explorer.</string>
  <string name="tooltip_packageDir">Rodmappen for add-on-strukturen i dit hovedbibliotek.</string>
  <string name="tooltip_packageTextureDir">Mappen for teksturmappen i din pakke.</string>
  <string name="tooltip_projectRootFolder">Rodmappen for dine Blender-projekter\neller hvor du ellers gemmer dine lakeringer.\nDette bruges som startmappe for filvalg.</string>
  <string name="tooltip_readonly">Feltet kan ikke redigeres.</string>
  <string name="tooltip_sdkRoot">MSFS SDK-rodmappe.\nHvis du tidligere har brugt ImageToMSFSKTX2, importeres dette også, når du klikker på knappen »Importer«.\nSDK'en er obligatorisk, hvis du arbejder på projekter, der bruger KTX2-formatet, da billeder konverteret med NVIDIA-værktøjet ikke fungerer i simulatoren.\nStandard er C:/MSFS 2024 SDK</string>
  <string name="tooltip_simType">Den butik, du bruger.\nEnten Microsoft eller Steam.\nStandard er Microsoft.</string>
  <string name="tooltip_textureFormat">Det teksturformat, som dit projekt arbejder med i MSFS2024.\nDDS eller KTX2.\nDenne værdi beregnes automatisk ud fra pakkens teksturmappe.</string>
  <string name="tooltip_textureTypes">De teksturtyper, du ønsker at inkludere i konverteringerne.\nMSFS-pakker kan indeholde mange teksturer, og normalt arbejder vi kun med\n albedo- (ALBD) og kompositionsfiler (COMP).\nI de fleste tilfælde bør du derfor vælge ALBD og COMP.\nHvis dit projekt ikke bruger metalliske farver, kan du roligt nøjes med at vælge ALBD.</string>
