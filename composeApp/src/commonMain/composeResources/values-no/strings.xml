  <string name="tooltip_mainLibraryRootFolder">Rotmappen til hovedbiblioteket ditt med tilleggsprogrammer\neller stedet der du lagrer de endelige pakkene dine for levering.\nDette brukes som startkatalog for Filechoose.</string>
  <string name="tooltip_modelTexturesDir">Teksturkatalogen til Blender-prosjektet ditt (eller prosjektet du jobber med).\nDette er katalogen der modellteksturene dine er lagret som PNG-filer.</string>
  <string name="tooltip_nvidiaTextureToolPath">Kjørbar fil «NVIDIA Texturetool».\nDette er obligatorisk og nødvendig for å konvertere teksturer fra ethvert simuleringsformat til PNG.\nStandardbanen er C:/Program Files/NVIDIA Corporation/NVIDIA Texture Tools/nvtt_export.exe.</string>
  <string name="tooltip_openInExplorer">Åpne i Utforsker.</string>
