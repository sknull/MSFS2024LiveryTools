  <string name="tooltip_nvidiaTextureToolPath">Izvršna datoteka \"NVIDIA Texturetool\".\nOvo je obavezno i potrebno za pretvaranje tekstura iz bilo kojeg simulacijskog formata u PNG.\nZadana putanja je C:/Program Files/NVIDIA Corporation/NVIDIA Texture Tools/nvtt_export.exe.</string>
