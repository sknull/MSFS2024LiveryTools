import de.visualdigits.msfs2024tools.data.model.configuration.ProjectConfigurationDto;
import kotlin.String;
import kotlin.collections.List;

--
-- SETTINGS
--
CREATE TABLE SettingsEntity (
    id INTEGER NOT NULL DEFAULT 0,
    version TEXT NOT NULL,
    language TEXT NOT NULL,
    simType TEXT NOT NULL,
    sdkRoot TEXT NOT NULL,
    layoutGeneratorToolPath TEXT NOT NULL,
    nvidiaTextureToolPath TEXT NOT NULL,
    mainLibraryRootFolder TEXT NOT NULL,
    projectRootFolder TEXT NOT NULL,
    airplanes TEXT AS List<String> NOT NULL,
    projects TEXT AS List<ProjectConfigurationDto> NOT NULL
);

insertSettings:
INSERT OR REPLACE INTO SettingsEntity (
    version, language, simType, sdkRoot, layoutGeneratorToolPath,
    nvidiaTextureToolPath, mainLibraryRootFolder, projectRootFolder,
    airplanes, projects
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getSettingsById:
SELECT * FROM SettingsEntity WHERE id = :id;

updateSettings:
UPDATE SettingsEntity
SET version = :version,
    language = :language,
    simType = :simType,
    sdkRoot = :sdkRoot,
    layoutGeneratorToolPath = :layoutGeneratorToolPath,
    nvidiaTextureToolPath = :nvidiaTextureToolPath,
    mainLibraryRootFolder = :mainLibraryRootFolder,
    projectRootFolder = :projectRootFolder,
    airplanes = :airplanes,
    projects = :projects
WHERE id IS :id;

deleteSettings:
DELETE FROM SettingsEntity
WHERE id IS :id;
